{
  "name": "pocket-cube-analyzer",
  "version": "1.0.0",
  "description": "固定朝向二阶魔方状态校验与最短复原搜索后端（TypeScript + Node.js + SQLite）",
  "type": "module",
  "main": "dist/src/cli/index.js",
  "bin": {
    "pocketcube": "dist/src/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test \"dist/test/**/*.test.js\"",
    "start": "node dist/src/api/server.js",
    "dev": "node --experimental-strip-types src/api/server.ts",
    "demo": "node dist/src/cli/index.js demo",
    "pdb": "node dist/src/cli/index.js pdb-build"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.5.0"
  }
}
